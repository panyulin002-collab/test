# 可选：用 systemd 代替 pm2 管理进程
# 安装：cp blog.service /etc/systemd/system/blog.service && systemctl daemon-reload && systemctl enable --now blog
[Unit]
Description=Blog platform (Node.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/blog-app
Environment=NODE_ENV=production
Environment=PORT=3000
# 站点跑在 HTTPS 后面时打开下面两行
# Environment=COOKIE_SECURE=1
# Environment=SITE_URL=https://你的域名
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
